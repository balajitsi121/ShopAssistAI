# Copy to .env and fill in. Never commit .env.
# LLM: any OpenAI-compatible chat API that supports tool calling.
# OpenRouter (free router):
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
# DeepSeek instead: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-v4-flash
# (DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL are still accepted.)

# Shared secret callers must send in the X-API-Key header (leave blank to disable locally)
SHOPASSIST_API_KEY=
# Comma-separated browser origins allowed to call the API (CORS), e.g. https://example.com
ALLOWED_ORIGINS=
